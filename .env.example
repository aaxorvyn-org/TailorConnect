# ----------------------------------------------------------------------
# TailorConnect Production Environment Variables (100% Free Tier Stack)
# ----------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=production
API_BASE_URL="https://your-api.onrender.com/api/v1"
WEB_APP_URL="https://your-app.vercel.app"

# Database Connection (Neon Serverless PostgreSQL - 100% Free Forever)
# Get your free connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/tailorconnect?sslmode=require"

# Authentication: Clerk.com (Free Forever up to 10,000 MAUs)
# Get keys from https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Native JWT Fallback (For direct API authentication / testing)
JWT_SECRET="generate_a_random_32_char_secret_for_production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="generate_a_second_random_32_char_secret_for_production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# AI Requirement Extraction: Google Gemini (Free Tier 15 RPM - No CC required)
# Get free key from https://aistudio.google.com
GEMINI_API_KEY=""

# File & Image Uploads (Local disk or Cloudinary free 25GB)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# Payments: Razorpay Test Mode (Free test keys for UPI / Card simulation)
# Get free test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
