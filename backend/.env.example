# Application Configuration
APP_NAME="Tailor Marketplace API"
APP_ENV=development
DEBUG=True
API_PREFIX=/api

# CORS Allowed Origins (Comma separated or JSON array string)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=tailor_marketplace_dev

# Optional full Database URL override (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=
